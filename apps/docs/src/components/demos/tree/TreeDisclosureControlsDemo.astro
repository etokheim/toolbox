---
---

<div id="tree-disclosure-controls-demo" class="not-content">
  <p>DOM disclosures</p>
  <tbw-grid id="disclosure-dom" aria-label="DOM disclosures"></tbw-grid>
  <p>React disclosures and Name links share the same provider and cell.</p>
  <div id="disclosure-react"></div>
  <div id="disclosure-react-second"></div>
  <output aria-live="polite" data-event-log>Tree: 0; details: 0; links: 0</output>
</div>

<script>
  import { queryGrid, type ControlView } from '@toolbox-web/grid';
  import { TreePlugin, type TreeDisclosureContext } from '@toolbox-web/grid/plugins/tree';
  import { MasterDetailPlugin, type MasterDetailDisclosureContext } from '@toolbox-web/grid/plugins/master-detail';
  import { DataGrid, type GridConfig, type TreeConfig, type MasterDetailConfig } from '@toolbox-web/grid-react';
  import '@toolbox-web/grid-react/features/tree';
  import '@toolbox-web/grid-react/features/master-detail';
  import { createContext, createElement, useContext } from 'react';
  import { createRoot } from 'react-dom/client';

  type Row = { id: string; name: string; children?: Row[] };
  type Context = TreeDisclosureContext<Row> | MasterDetailDisclosureContext<Row>;
  const rows: Row[] = Array.from({ length: 60 }, (_, i) => ({
    id: `parent-${i}`, name: `Parent ${i}`,
    children: Array.from({ length: 30 }, (_, j) => ({ id: `child-${i}-${j}`, name: `Child ${i}.${j}` })),
  }));
  const label = (context: Context) =>
    'ariaLabel' in context ? context.ariaLabel : `Children of ${context.row.name}`;

  function domDisclosure(initial: Context): ControlView<Context> {
    const element = document.createElement('button');
    element.type = 'button';
    let context = initial;
    const update = (next: Context) => {
      context = next;
      element.setAttribute('aria-label', label(next));
      element.setAttribute('aria-expanded', String(next.expanded));
      element.disabled = next.disabled;
      element.textContent = next.loading ? '...' : next.expanded ? '-' : '+';
    };
    element.onclick = () => context.setExpanded(!context.expanded);
    update(initial);
    return { element, update };
  }
  const dom = queryGrid<Row>('#disclosure-dom');
  dom.gridConfig = {
    columns: [{ field: 'name' }],
    plugins: [
      new TreePlugin<Row>({ treeColumn: 'name', animation: false, disclosureRenderer: domDisclosure }),
      new MasterDetailPlugin<Row>({
        animation: false, disclosureRenderer: domDisclosure, detailRenderer: (row) => `Details: ${row['name']}`,
      }),
    ],
  };
  dom.rows = rows;

  const Theme = createContext('missing');
  function Disclosure({ context }: { context: Context }) {
    return createElement('button', {
      type: 'button', 'data-theme': useContext(Theme),
      'data-disclosure': 'ariaLabel' in context ? 'detail' : 'tree',
      'aria-label': label(context), 'aria-expanded': context.expanded, disabled: context.disabled,
      onClick: () => context.setExpanded(!context.expanded),
    }, createElement('svg', { 'aria-hidden': true, width: 18, height: 18, viewBox: '0 0 18 18' },
      createElement('path', { d: context.expanded ? 'M4 6L9 12L14 6' : 'M6 4L12 9L6 14', fill: 'none', stroke: 'currentColor', strokeWidth: 2 })));
  }
  const container = document.getElementById('tree-disclosure-controls-demo')!;
  let treeEvents = 0, detailEvents = 0, links = 0;
  const report = () => {
    container.querySelector('output')!.textContent = `Tree: ${treeEvents}; details: ${detailEvents}; links: ${links}`;
  };
  container.addEventListener('tree-expand', () => { treeEvents++; report(); });
  container.addEventListener('detail-expand', () => { detailEvents++; report(); });
  function Name({ row }: { row: Row }) {
    return createElement('a', {
      href: `#${row.id}`, 'data-name': row.id, 'data-theme': useContext(Theme),
      onClick: (event) => { event.preventDefault(); links++; report(); },
    }, row.name);
  }
  function Detail() {
    return createElement('p', { 'data-detail': useContext(Theme) }, 'Independent detail panel');
  }
  const gridConfig: GridConfig<Row> = {
    columns: [{ field: 'name', header: 'Name', renderer: ({ row }) => createElement(Name, { row }) }],
  };
  const tree: TreeConfig<Row> = {
    treeColumn: 'name', animation: false, disclosureRenderer: (context) => createElement(Disclosure, { context }),
  };
  const masterDetail: MasterDetailConfig<Row> = {
    animation: false, expandOnRowClick: true,
    disclosureRenderer: (context) => createElement(Disclosure, { context }),
    detailRenderer: () => createElement(Detail),
  };
  const roots = ['disclosure-react', 'disclosure-react-second'].map((id) => {
    const root = createRoot(document.getElementById(id)!);
    root.render(createElement(Theme.Provider, { value: id },
      createElement(DataGrid<Row>, { rows, gridConfig, tree, masterDetail, 'aria-label': id })));
    return root;
  });
  document.addEventListener('astro:before-swap', () => roots.forEach((root) => root.unmount()), { once: true });
</script>

<style is:global>
  #tree-disclosure-controls-demo tbw-grid { height: 280px; }
  #tree-disclosure-controls-demo button {
    width: 26px; height: 26px; padding: 2px; color: inherit;
    background: transparent; border: 1px solid currentColor; border-radius: 4px;
  }
  #tree-disclosure-controls-demo button:focus-visible { outline: 2px solid currentColor; }
  #tree-disclosure-controls-demo button:disabled { opacity: 0.5; }
</style>
